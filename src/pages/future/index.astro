---
import Base from '../../layouts/Base.astro';
import FutureNav from '../../components/FutureNav.astro';
import EvidenceItem from '../../components/EvidenceItem.astro';
import publications from '../../data/publications.json';
import { ideas, proof, type Theme } from '../../data/ideas';
import '../../styles/future.css';

type Entry = { date: string; venue: string; title: string; type?: string; themes?: Theme[] };
const all = (publications as Entry[]).slice().sort((a, b) => b.date.localeCompare(a.date));

const statsFor = (t: Theme) => {
  const hits = all.filter(e => e.themes?.includes(t));
  return { count: hits.length, since: hits.map(e => e.date.slice(0, 4)).sort()[0] };
};
const quotes = ideas.flatMap(i => i.quotes.map(q => ({ ...q, idea: i })));
const venues = new Set(all.map(e => e.venue)).size;
const LINKEDIN = 'https://www.linkedin.com/in/david-nyurenberg-1b56578b/';
---
<Base title="David Nyurenberg" noindex
  description="David Nyurenberg on making connected TV accountable: show-level transparency, honest measurement, aligned incentives and agentic buying.">
  <FutureNav />

  <header class="fhero">
    <div class="shell fhero__grid">
      <div>
        <span class="eyebrow">SVP, Digital · InterMedia Advertising</span>
        <h1 class="fhero__title">Make streaming<br/>accountable<span class="dot">.</span></h1>
        <p class="fhero__lede">
          David Nyurenberg buys television for performance advertisers and argues, in print and on stage,
          that streaming should be bought like television: <em>by the show</em>, <em>for the household</em>,
          with the <em>incentives in plain sight</em>, and with AI agents that make operators sharper.
        </p>
        <ul class="fhero__ideas">
          {ideas.map(i => (
            <li><a href={`/future/ideas/${i.slug}/`}><span>{i.num}</span>{i.title}</a></li>
          ))}
        </ul>
      </div>
      <figure class="portrait">
        <span class="portrait__echo" aria-hidden="true"></span>
        <picture>
          <source srcset="/david.webp" type="image/webp" />
          <img src="/david.jpg" alt="David Nyurenberg" width="720" height="720" loading="eager" decoding="async" />
        </picture>
      </figure>
    </div>
  </header>

  <section class="fsection">
    <div class="shell">
      <h2 class="fsection__label">Four arguments</h2>
      <div class="cards">
        {ideas.map(i => {
          const s = statsFor(i.theme);
          return (
            <a class={`card card--${i.theme}`} href={`/future/ideas/${i.slug}/`}>
              <span class="card__num">{i.num}</span>
              <h3 class="card__title">{i.title}</h3>
              <p class="card__thesis">{i.thesis}</p>
              <span class="card__meta">{s.count} pieces · argued since {s.since} <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="fsection fsection--ink">
    <div class="shell">
      <h2 class="fsection__label">Work with outcomes</h2>
      <div class="proof">
        {proof.map(p => (
          <a class="proof__item" href={p.url} target="_blank" rel="noopener">
            <span class="proof__year">{p.year}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <span class="proof__src">{p.source} ↗</span>
          </a>
        ))}
      </div>
      <p class="proof__note">
        InterMedia Advertising: <a href="https://www.prnewswire.com/news-releases/intermedia-advertising-earns-five-2026-adexchanger-award-nominations-302861854.html" target="_blank" rel="noopener">five 2026 AdExchanger Awards finalist nominations</a> for this work.
      </p>
    </div>
  </section>

  <section class="fsection">
    <div class="shell">
      <h2 class="fsection__label">In his words</h2>
      <div class="quotes">
        {quotes.map(q => (
          <figure class={`quote quote--${q.idea.theme}`}>
            <blockquote>“{q.text}”</blockquote>
            <figcaption>
              <a href={q.url} target="_blank" rel="noopener">{q.source}</a>
              <span> · </span>
              <a href={`/future/ideas/${q.idea.slug}/`}>{q.idea.title.replace(/\.$/, '')}</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="fsection">
    <div class="shell">
      <div class="fsection__head">
        <h2 class="fsection__label">Latest</h2>
        <a href="/" class="fsection__more">All {all.length} entries across {venues} outlets →</a>
      </div>
      <ul class="evlist">
        {all.slice(0, 6).map(e => <EvidenceItem entry={e as any} />)}
      </ul>
    </div>
  </section>

  <section class="fcta">
    <div class="shell fcta__inner">
      <h2>Speaking, advisory and press.</h2>
      <p>Conference stages, podcasts, panels and editorial requests on CTV, programmatic and agentic buying.</p>
      <a class="fcta__btn" href={LINKEDIN} target="_blank" rel="noopener">Get in touch on LinkedIn →</a>
    </div>
  </section>
</Base>
