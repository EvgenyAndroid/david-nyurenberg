---
import Base from '../layouts/Base.astro';
import FutureNav from '../components/FutureNav.astro';
import EvidenceItem from '../components/EvidenceItem.astro';
import Contact from '../components/Contact.astro';
import publications from '../data/publications.json';
import { ideas, proof, awards, type Theme } from '../data/ideas';
import '../styles/future.css';
import { person, SITE } from '../data/person';

type Entry = { date: string; venue: string; title: string; type?: string; themes?: Theme[] };
const all = (publications as Entry[]).slice().sort((a, b) => b.date.localeCompare(a.date));

const statsFor = (t: Theme) => {
  const hits = all.filter(e => e.themes?.includes(t));
  return { count: hits.length, since: hits.map(e => e.date.slice(0, 4)).sort()[0] };
};
// Two standout lines; the rest live on the argument pages.
const quotes = [ideas[0].quotes[0], ideas[1].quotes[1]].map((q, n) => ({ ...q, idea: ideas[n] }));
const venues = new Set(all.map(e => e.venue)).size;
---
<Base title="David Nyurenberg"
  jsonLd={{ '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'David Nyurenberg', publisher: { '@id': person['@id'] } },
    { '@type': 'ProfilePage', url: `${SITE}/`, name: 'David Nyurenberg', mainEntity: { '@id': person['@id'] } },
    person,
  ] }}
  description="David Nyurenberg on making connected TV accountable: show-level transparency, honest measurement, aligned incentives and agentic buying.">
  <FutureNav />

  <header class="fhero">
    <div class="shell fhero__grid">
      <div>
        <span class="eyebrow">SVP, Digital · InterMedia Advertising</span>
        <h1 class="fhero__title">Make streaming<br/>accountable<span class="dot">.</span></h1>
        <p class="fhero__lede">
          David Nyurenberg buys television for performance advertisers and argues, in print and on stage,
          that streaming should be bought like television: <em>by the show</em>, <em>for the household</em>,
          with the <em>incentives in plain sight</em>, and with AI agents that make operators sharper.
        </p>
        <div class="fhero__actions">
          <a class="fcta__btn" href="#contact">Speaking &amp; press</a>
          <a class="fhero__link" href="#arguments">Read the four arguments ↓</a>
        </div>
      </div>
      <figure class="portrait">
        <span class="portrait__echo" aria-hidden="true"></span>
        <picture>
          <source srcset="/david.webp" type="image/webp" />
          <img src="/david.jpg" alt="David Nyurenberg" width="720" height="720" loading="eager" decoding="async" />
        </picture>
      </figure>
    </div>
  </header>

  <section class="fsection" id="arguments">
    <div class="shell">
      <h2 class="fsection__label">Four arguments</h2>
      <div class="cards">
        {ideas.map(i => {
          const s = statsFor(i.theme);
          return (
            <a class={`card card--${i.theme}`} href={`/ideas/${i.slug}/`}>
              <span class="card__num">{i.num}</span>
              <h3 class="card__title">{i.title}</h3>
              <p class="card__thesis">{i.thesis}</p>
              <span class="card__meta">{s.count} pieces · {i.sinceNote ?? `related work since ${s.since}`} <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="fsection fsection--ink">
    <div class="shell">
      <h2 class="fsection__label">Work with outcomes</h2>
      <div class="proof">
        {proof.map(p => (
          <a class="proof__item" href={p.url} target="_blank" rel="noopener">
            <span class="proof__year">{p.year} · {p.org}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            {p.stats && (
              <dl class="proof__stats">
                {p.stats.map(st => <div><dt>{st.v}</dt><dd>{st.l}</dd></div>)}
              </dl>
            )}
            <span class="proof__src">{p.source} ↗</span>
          </a>
        ))}
      </div>
      <div class="awards">
        <div class="awards__text">
          <span class="awards__label">2026 AdExchanger Awards · InterMedia Advertising</span>
          <ul>
            {awards.wins.map(w => (
              <li>
                <span class="awards__win">Winner</span>
                <strong>{w.category}</strong>
                <span>{w.entry}</span>
              </li>
            ))}
          </ul>
          <a href={awards.url} target="_blank" rel="noopener">All winners on AdExchanger ↗</a>
        </div>
        <div class="awards__photos">
          <a class="shot" href="/awards/both-trophies.jpg" target="_blank" rel="noopener">
            <picture>
              <source srcset="/awards/both-trophies-thumb.webp" type="image/webp" />
              <img src="/awards/both-trophies-thumb.jpg" width="560" height="747" loading="lazy" decoding="async"
                alt="David Nyurenberg, right, holding both 2026 AdExchanger Awards trophies on the red carpet" />
            </picture>
            <span class="shot__cap">Both wins</span>
          </a>
          <a class="shot shot--tall" href="/awards/team.jpg" target="_blank" rel="noopener">
            <picture>
              <source srcset="/awards/team-thumb.webp" type="image/webp" />
              <img src="/awards/team-thumb.jpg" width="560" height="769" loading="lazy" decoding="async"
                alt="David Nyurenberg, second from left, with InterMedia colleagues and the trophy at the 2026 AdExchanger Awards" />
            </picture>
            <span class="shot__cap">On the night</span>
          </a>
          <a class="shot" href="/awards/trophies.jpg" target="_blank" rel="noopener">
            <picture>
              <source srcset="/awards/trophies-thumb.webp" type="image/webp" />
              <img src="/awards/trophies-thumb.jpg" width="560" height="645" loading="lazy" decoding="async"
                alt="The two 2026 AdExchanger Awards trophies presented to InterMedia Advertising" />
            </picture>
            <span class="shot__cap">Two trophies</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="fsection">
    <div class="shell">
      <h2 class="fsection__label">In his words</h2>
      <div class="quotes">
        {quotes.map(q => (
          <figure class={`quote quote--${q.idea.theme}`}>
            <blockquote>“{q.text}”</blockquote>
            <figcaption>
              <a href={q.url} target="_blank" rel="noopener">{q.source}</a>
              <span> · </span>
              <a href={`/ideas/${q.idea.slug}/`}>{q.idea.title.replace(/\.$/, '')}</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="fsection">
    <div class="shell">
      <div class="fsection__head">
        <h2 class="fsection__label">Latest</h2>
        <a href="/archive/" class="fsection__more">All {all.length} entries across {venues} outlets →</a>
      </div>
      <ul class="evlist">
        {all.slice(0, 6).map(e => <EvidenceItem entry={e as any} />)}
      </ul>
    </div>
  </section>

  <Contact />
</Base>
