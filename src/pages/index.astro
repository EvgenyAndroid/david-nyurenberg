---
import Base from '../layouts/Base.astro';
import publications from '../data/publications.json';
import linkedinUrls from '../data/linkedin-urls.json';

// ─── LinkedIn / per-piece deep-link resolver ─────────────────────────────
// Maps each known piece to its specific URL (LinkedIn /pulse, Medium, etc.).
// Two lookups: byEssaySlug (if you have a stable slug) and byTitleKey
// (fuzzy normalized title match). Both defined in src/data/linkedin-urls.json.
function titleKey(s: string): string {
  return s
    .toLowerCase()
    .replace(/[‘’']/g, '')
    .replace(/[“”"]/g, '')
    .replace(/[—–:,!?.]/g, ' ')
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}
function deepLink(slug: string | undefined, title: string): string | null {
  if (slug && (linkedinUrls.byEssaySlug as any)[slug]) return (linkedinUrls.byEssaySlug as any)[slug];
  const key = titleKey(title);
  if ((linkedinUrls.byTitleKey as any)[key]) return (linkedinUrls.byTitleKey as any)[key];
  return null;
}

// ─── External-venue search-page fallback ─────────────────────────────────
// When a piece doesn't have a known direct URL, link to the venue's author
// or search page pre-filled with the title — user lands on the venue and
// clicks the actual article. One extra click but no broken links.
function searchTerm(title: string): string {
  return title
    .replace(/[—–-]/g, ' ')
    .replace(/[^\w\s]/g, ' ')
    .split(/\s+/).filter(Boolean).slice(0, 8).join(' ');
}
function externalUrl(entry: any): string | null {
  const deep = deepLink(entry.slug, entry.title);
  if (deep) return deep;
  const q = encodeURIComponent(searchTerm(entry.title));
  switch (entry.venue) {
    case 'LinkedIn':         return 'https://www.linkedin.com/';
    case 'Medium':           return `https://medium.com/search?q=${q}`;
    case 'Forbes':           return 'https://www.forbes.com/';
    case 'Substack':         return 'https://substack.com/';
    default:                 return null;
  }
}

// ─── Pub entry shape ─────────────────────────────────────────────────────
type Entry = {
  date: string;     // YYYY-MM or YYYY-MM-DD
  venue: string;
  title: string;
  subtitle?: string | null;
  synopsis?: string;
  kind?: 'article' | 'podcast' | 'whitepaper' | 'note';
  slug?: string;
  url?: string;     // explicit per-entry URL (overrides resolver)
};

const all = (publications as Entry[])
  .slice()
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

function urlFor(e: Entry): string {
  if (e.url) return e.url;
  return externalUrl(e) || '#';
}

// ─── Year grouping (newest first) ───────────────────────────────────────
const years = Array.from(new Set(all.map(e => (e.date || '').slice(0, 4))))
  .filter(Boolean)
  .sort((a, b) => b.localeCompare(a));

// ─── Venues + counts for filter chips ────────────────────────────────────
const venueCounts: Record<string, number> = {};
all.forEach(e => {
  venueCounts[e.venue] = (venueCounts[e.venue] || 0) + 1;
});
const venuesSortedByCount = Object.entries(venueCounts)
  .sort(([, a], [, b]) => b - a);

function formatDate(date: string): string {
  if (!date) return '';
  const [y, m] = date.split('-');
  if (!m) return y;
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${monthNames[parseInt(m, 10) - 1] || ''} ${y}`;
}
---
<Base
  title="David Nyurenberg"
  description={`Selected bylines and published work by David Nyurenberg across ${venuesSortedByCount.length || 'multiple'} publications.`}
>

  <!-- ─── Hero ─── -->
  <section class="hero">
    <div class="shell">
      <span class="eyebrow">Writing & Press</span>
      <h1 class="display">David<br/>Nyurenberg<span class="dot">.</span></h1>
      <p class="hero__sub">
        {all.length > 0 ? (
          <>Selected bylines across <strong>{venuesSortedByCount.length}</strong> publications. <strong>{all.length}</strong> entries.</>
        ) : (
          <>Selected bylines and published work. <em>(Content loading.)</em></>
        )}
      </p>
    </div>
  </section>

  {all.length > 0 ? (
    <!-- ─── Search + filter strip ─── -->
    <section class="archive">
      <div class="shell">
        <!-- Search input -->
        <div class="search-row" data-search-row>
          <label for="bib-search" class="visually-hidden">Search bylines</label>
          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="20" y1="20" x2="16.5" y2="16.5" />
            </svg>
            <input
              id="bib-search"
              type="search"
              class="search-input"
              placeholder={`Search ${all.length} bylines by title, venue, synopsis…`}
              autocomplete="off"
              data-search-input
            />
            <button type="button" class="search-clear" data-search-clear hidden aria-label="Clear search">×</button>
          </div>
          <span class="search-count" data-search-count hidden></span>
        </div>

        <!-- Venue filter chips -->
        <div class="venue-filter" role="group" aria-label="Filter by publication" data-filter>
          <button class="venue-chip is-active" data-venue="" aria-pressed="true" type="button">
            <span class="venue-chip__name">All</span>
            <span class="venue-chip__count">{all.length}</span>
          </button>
          {venuesSortedByCount.map(([venue, count]) => (
            <button class="venue-chip" data-venue={venue} aria-pressed="false" type="button">
              <span class="venue-chip__name">{venue}</span>
              <span class="venue-chip__count">{count}</span>
            </button>
          ))}
        </div>
        <p class="filter-empty" data-filter-empty hidden>
          <span data-filter-empty-msg>No entries match this filter.</span>
        </p>

        <!-- Bibliography by year -->
        {years.map(year => (
          <section class="year-section" data-year={year}>
            <h2 class="year-section__heading">{year}</h2>
            <ul class="bib-list">
              {all.filter(e => (e.date || '').startsWith(year)).map(e => {
                const href = urlFor(e);
                const external = href !== '#';
                const haystack = `${e.title} ${e.venue} ${e.synopsis || ''} ${e.subtitle || ''}`.toLowerCase();
                return (
                  <li
                    class="bib-item"
                    data-venue={e.venue}
                    data-search={haystack}
                  >
                    <a
                      href={href}
                      class="bib-link"
                      {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      <div class="bib-meta">
                        <span class="bib-date">{formatDate(e.date)}</span>
                        <span class="bib-sep">·</span>
                        <span class="bib-venue">{e.venue}</span>
                      </div>
                      <div class="bib-title">{e.title}</div>
                      {e.subtitle && <div class="bib-subtitle">{e.subtitle}</div>}
                      {e.synopsis && <div class="bib-synopsis">{e.synopsis}</div>}
                      {external && <span class="bib-arrow" aria-hidden="true">↗</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </section>
  ) : (
    <section class="empty-state">
      <div class="shell">
        <p>Content loading. Publications will appear here.</p>
      </div>
    </section>
  )}

  <script>
    // ─── Search + venue filter ──────────────────────────────────────────
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter] [data-venue]');
    const items = document.querySelectorAll<HTMLLIElement>('.bib-item');
    const yearSections = document.querySelectorAll<HTMLElement>('.year-section');
    const emptyMsg = document.querySelector<HTMLElement>('[data-filter-empty]');
    const emptyMsgText = document.querySelector<HTMLElement>('[data-filter-empty-msg]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
    const searchClear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
    const searchCount = document.querySelector<HTMLElement>('[data-search-count]');

    const state = { venue: '', query: '' };

    function applyFilters() {
      const q = state.query.trim().toLowerCase();
      let visible = 0;

      items.forEach(li => {
        const venueOk = !state.venue || li.dataset.venue === state.venue;
        const searchOk = !q || (li.dataset.search || '').includes(q);
        const match = venueOk && searchOk;
        li.hidden = !match;
        if (match) visible++;
      });

      yearSections.forEach(section => {
        const anyVisible = Array.from(section.querySelectorAll<HTMLLIElement>('.bib-item'))
          .some(li => !li.hidden);
        section.hidden = !anyVisible;
      });

      // Empty-state messaging
      if (emptyMsg && emptyMsgText) {
        if (visible === 0 && (state.venue || q)) {
          let msg = 'No entries match this filter.';
          if (q && state.venue) {
            const activeBtn = document.querySelector<HTMLButtonElement>(`[data-venue="${state.venue}"]`);
            const venueName = activeBtn?.querySelector('.venue-chip__name')?.textContent || state.venue;
            msg = `No entries from ${venueName} matching "${q}".`;
          } else if (q) {
            msg = `No entries matching "${q}".`;
          } else if (state.venue) {
            const activeBtn = document.querySelector<HTMLButtonElement>(`[data-venue="${state.venue}"]`);
            const venueName = activeBtn?.querySelector('.venue-chip__name')?.textContent || state.venue;
            msg = `No entries from ${venueName} yet.`;
          }
          emptyMsgText.textContent = msg;
          emptyMsg.hidden = false;
        } else {
          emptyMsg.hidden = true;
        }
      }

      if (searchCount) {
        if (q || state.venue) {
          searchCount.textContent = `${visible} of ${items.length}`;
          searchCount.hidden = false;
        } else {
          searchCount.hidden = true;
        }
      }
      if (searchClear) searchClear.hidden = !q;
      buttons.forEach(btn => {
        const isActive = (btn.dataset.venue || '') === state.venue;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // URL sync — shareable filter state
      const u = new URL(window.location.href);
      state.venue ? u.searchParams.set('venue', state.venue) : u.searchParams.delete('venue');
      q ? u.searchParams.set('q', q) : u.searchParams.delete('q');
      window.history.replaceState(null, '', u.toString());
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.venue || '';
        const isActive = btn.classList.contains('is-active');
        state.venue = (isActive && v) ? '' : v;
        applyFilters();
      });
    });

    let searchTimer: number | undefined;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          state.query = searchInput.value;
          applyFilters();
        }, 80);
      });
      searchInput.addEventListener('keydown', e => {
        if (e.key === 'Escape' && searchInput.value) {
          searchInput.value = '';
          state.query = '';
          applyFilters();
        }
      });
    }
    if (searchClear && searchInput) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        state.query = '';
        applyFilters();
        searchInput.focus();
      });
    }

    // Hydrate state from URL
    const usp = new URLSearchParams(window.location.search);
    const initialVenue = usp.get('venue') || '';
    const initialQ = usp.get('q') || '';
    if (initialVenue) state.venue = initialVenue;
    if (initialQ) {
      state.query = initialQ;
      if (searchInput) searchInput.value = initialQ;
    }
    if (state.venue || state.query) applyFilters();
  </script>

</Base>
