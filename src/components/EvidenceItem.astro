---
import { themeLabels, ideas, type Theme } from '../data/ideas';

type Entry = {
  date: string; venue: string; title: string; type?: string; synopsis?: string;
  url?: string; themes?: Theme[]; links?: { label: string; url: string }[];
};
const { entry: e, hideTheme } = Astro.props as { entry: Entry; hideTheme?: Theme };

const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const [y, m] = e.date.split('-');
const when = m ? `${months[+m - 1]} ${y}` : y;
const ideaFor = (t: Theme) => ideas.find(i => i.theme === t);
const tags = (e.themes || []).filter(t => t !== hideTheme && t !== 'career');
---
<li class="ev">
  <div class="ev__when">{when}</div>
  <div class="ev__body">
    <div class="ev__meta">
      {e.type && <span class={`bib-type bib-type--${e.type.toLowerCase().replace(/\s+/g, '-')}`}>{e.type}</span>}
      <span>{e.venue}</span>
    </div>
    <a class="ev__title" href={e.url} target="_blank" rel="noopener">{e.title} <span aria-hidden="true">↗</span></a>
    {e.synopsis && <p class="ev__syn">{e.synopsis}</p>}
    {(tags.length > 0 || e.links) && (
      <div class="ev__foot">
        {e.links?.map(l => <a class="ev__extra" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
        {tags.map(t => {
          const idea = ideaFor(t);
          return idea
            ? <a class={`tag tag--${t}`} href={`/future/ideas/${idea.slug}/`}>{themeLabels[t]}</a>
            : <span class={`tag tag--${t}`}>{themeLabels[t]}</span>;
        })}
      </div>
    )}
  </div>
</li>
