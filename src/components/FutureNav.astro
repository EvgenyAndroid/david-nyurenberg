---
import { ideas } from '../data/ideas';
const { current = '' } = Astro.props as { current?: string };
---
<nav class="fnav" aria-label="Site">
  <div class="shell fnav__inner">
    <a href="/" class="fnav__brand">David Nyurenberg<span class="dot">.</span></a>
    <ul class="fnav__links">
      {ideas.map(i => (
        <li>
          <a href={`/ideas/${i.slug}/`} aria-current={current === i.slug ? 'page' : undefined}>
            {i.nav}
          </a>
        </li>
      ))}
      <li class="fnav__keep"><a href="/archive/" class="fnav__archive" aria-current={current === 'archive' ? 'page' : undefined}>Archive</a></li>
      <li class="fnav__keep">
        <a href="/#contact" class="fnav__cta">Get in touch</a>
      </li>
    </ul>
  </div>
</nav>
